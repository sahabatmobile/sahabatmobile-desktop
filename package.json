{
  "name": "sahabat-desktop",
  "version": "1.1.0",
  "description": "Aplikasi desktop AI Gateway SahabatMobile",
  "main": "main.js",
  "author": "SahabatMobile",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sahabatmobile.desktop",
    "productName": "SahabatMobile Desktop",
    "icon": "build/icon.png",
    "asarUnpack": [
      "extensions/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "db.js",
      "package.json",
      "extensions/**/*",
      "vendor/**/*",
      "node_modules/**/*"
   ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ace-builds": "^1.45.2",
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.5",
    "mongodb": "^7.8.0",
    "mssql": "^12.7.13",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "sql.js": "^1.15.2",
    "ssh2": "^1.17.0"
  }
}
