snippet log
    console.log(${1});
snippet fn
    function ${1:name}(${2:args}) {
        ${3}
    }
snippet async
    async function ${1:name}(${2:args}) {
        ${3}
    }
snippet arrow
    const ${1:name} = (${2:args}) => {
        ${3}
    }
snippet forof
    for (const ${1:item} of ${2:items}) {
        ${3}
    }
snippet trycatch
    try {
        ${1}
    } catch (${2:err}) {
        ${3:console.error(err)}
    }
snippet promise
    new Promise((resolve, reject) => {
        ${1}
    })
snippet fetch
    const res = await fetch(${1:url});
    const data = await res.json();
