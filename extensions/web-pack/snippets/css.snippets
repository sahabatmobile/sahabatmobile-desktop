snippet flex
    display: flex;
    align-items: ${1:center};
    justify-content: ${2:center};
    gap: ${3:8px};
snippet grid
    display: grid;
    grid-template-columns: ${1:repeat(2, 1fr)};
    gap: ${2:16px};
snippet btn
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: ${1:8px 16px};
    border: 0;
    border-radius: ${2:8px};
    cursor: pointer;
snippet center
    display: grid;
    place-items: center;
snippet card
    background: ${1:#fff};
    border: 1px solid ${2:#e5e7eb};
    border-radius: ${3:12px};
    padding: ${4:16px};
